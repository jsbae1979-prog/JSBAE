+# Verification-copy-only capability registration. No global DLL/symbol expansion.
+_VERIFICATION_CAPABILITY=None
+_VERIFICATION_ORIGINAL_LOADER=ctypes.WinDLL
+
+def register_verification_capability(capability):
+ global _VERIFICATION_CAPABILITY
+ if not INSTALLED:deny('capability-registration-before-Guard')
+ if _VERIFICATION_CAPABILITY is not None:deny('capability-already-registered')
+ kind=type(capability)
+ if kind.__name__!='NativeRegistration' or kind.__module__!='guard_capability':deny('unreviewed-capability-type')
+ module=sys.modules.get(kind.__module__)
+ expected=CONFIG.get('verification_capability_sha256')
+ if module is None or not re.fullmatch(r'[0-9a-f]{64}',expected or ''):deny('capability-manifest-required')
+ if hashlib.sha256(pathlib.Path(module.__file__).read_bytes()).hexdigest()!=expected:deny('capability-source-hash')
+ capability.attach_private_loader(_VERIFICATION_ORIGINAL_LOADER)
+ _VERIFICATION_CAPABILITY=capability
+ return 'registered-synthetic-native-lock-v1'
+
+def _verification_capability_event(event,args):
+ if _VERIFICATION_CAPABILITY is None:return False
+ return _VERIFICATION_CAPABILITY.audit_event(event,args)
+
+def _verification_private_binding(name,args,kwargs):
+ if _VERIFICATION_CAPABILITY is None:return None
+ return _VERIFICATION_CAPABILITY.private_binding(name,args,kwargs)
