# Set these in your shell; .env is an example, not automatically loaded.
NEWSFLOW_HOST=127.0.0.1
NEWSFLOW_PORT=8765
# Windows default: %LOCALAPPDATA%\NewsFlowAI; omit override for normal use.
# NEWSFLOW_DATA_DIR=C:\Users\your-user\AppData\Local\NewsFlowAI
NEWSFLOW_REQUEST_TIMEOUT=10
# Optional private session signing key; otherwise generated locally in data/.
NEWSFLOW_SECRET_KEY=
# Opt-in live tests only:
NEWSFLOW_LIVE_TEST=0
